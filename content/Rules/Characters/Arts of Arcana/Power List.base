views:
  - type: table
    name: Table
    filters:
      and:
        - file.tags.contains("powers")
        - file.folder != "z_templates"
        - '!file.tags.contains("ability")'
    order:
      - file.name
      - tier
      - art
      - action
      - cost
      - attributes
      - tags
    sort:
      - property: tier
        direction: ASC
